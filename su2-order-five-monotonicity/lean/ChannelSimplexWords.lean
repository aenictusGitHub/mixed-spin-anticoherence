/-! Exact normal-ordering lemmas; every equality is checked by Lean.
The generator performs only symbolic preprocessing and is outside the trust base. -/
namespace SU2T2.Spin
open Matrix Module
noncomputable section
set_option linter.unusedSimpArgs false
