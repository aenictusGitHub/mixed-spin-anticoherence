def table : Fin 6 → Band := ![table0,table1,table2,table3,table4,table5]

private theorem start : table0=initialBand := by
  funext i j h; revert i j h; decide +kernel

private theorem step1 : advance table0=table1 := by
  funext i j h; revert i j h; decide +kernel

private theorem step2 : advance table1=table2 := by
  funext i j h; revert i j h; decide +kernel

private theorem step3 : advance table2=table3 := by
  funext i j h; revert i j h; decide +kernel

private theorem step4 : advance table3=table4 := by
  funext i j h; revert i j h; decide +kernel

private theorem step5 : advance table4=table5 := by
  funext i j h; revert i j h; decide +kernel

theorem iterate_table (d : Fin 6) (X : Matrix (Fin 6) (Fin 6) ℚ) :
    (stencil^[d.val]) X = bandEval (table d) X := by
  have h0 : (stencil^[0]) X = bandEval table0 X := by rw [start,initialBand_eval]; rfl
  have h1 : (stencil^[1]) X = bandEval table1 X := by
    rw [show 1=0+1 by decide,Function.iterate_succ_apply',h0,advance_eval,step1]
  have h2 : (stencil^[2]) X = bandEval table2 X := by
    rw [show 2=1+1 by decide,Function.iterate_succ_apply',h1,advance_eval,step2]
  have h3 : (stencil^[3]) X = bandEval table3 X := by
    rw [show 3=2+1 by decide,Function.iterate_succ_apply',h2,advance_eval,step3]
  have h4 : (stencil^[4]) X = bandEval table4 X := by
    rw [show 4=3+1 by decide,Function.iterate_succ_apply',h3,advance_eval,step4]
  have h5 : (stencil^[5]) X = bandEval table5 X := by
    rw [show 5=4+1 by decide,Function.iterate_succ_apply',h4,advance_eval,step5]
  fin_cases d <;> first | exact h0 | exact h1 | exact h2 | exact h3 | exact h4 | exact h5
end OrderFive.Coordinates
