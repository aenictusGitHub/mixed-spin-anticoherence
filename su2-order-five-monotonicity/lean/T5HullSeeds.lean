theorem available_seedAt : ∀ u : Fin 80, available (seedAt u) 18 = true := by decide +kernel
theorem tableAt_eq : ∀ (u : Fin 80) (l : Fin 5), tableAt u l = rationalPoint (seedAt u) l := by decide +kernel

def tableCert (p : Fin 5 → ℚ) (ids : Fin 6 → Fin 80) (w : Fin 6 → ℚ) : Prop :=
  (∀ u, 0 ≤ w u) ∧ (∑ u,w u=1) ∧ ∀ l, ∑ u, w u * tableAt (ids u) l = p l
instance (p : Fin 5 → ℚ) (ids : Fin 6 → Fin 80) (w : Fin 6 → ℚ) :
    Decidable (tableCert p ids w) :=
  inferInstanceAs (Decidable ((∀ u, 0 ≤ w u) ∧ (∑ u,w u=1) ∧ ∀ l, ∑ u, w u * tableAt (ids u) l = p l))

theorem tableCert_mem {p : Fin 5 → ℚ} {s : Fin 6 → Fin 80} {w : Fin 6 → ℚ}
    (h : tableCert p s w) : (fun l => (p l:ℝ)) ∈ convexHull ℝ (vertices 18) := by
  apply mem_convexHull_of_exists_fintype (ι := Fin 6) (fun u => (w u:ℝ)) (fun u => point (seedAt (s u)))
  · intro i; exact_mod_cast h.1 i
  · exact_mod_cast h.2.1
  · intro i; exact ⟨seedAt (s i),available_seedAt _,rfl⟩
  · ext i
    simp only [Finset.sum_apply, Pi.smul_apply,smul_eq_mul,point,←tableAt_eq]
    exact_mod_cast h.2.2 i
