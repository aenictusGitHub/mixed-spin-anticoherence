/-- Every point of the unit square is covered, including box boundaries. -/
theorem t3Facet06_nonneg (Y Z : ℝ)
    (hY0 : 0 ≤ Y) (hY1 : Y ≤ 1) (hZ0 : 0 ≤ Z) (hZ1 : Z ≤ 1) :
    0 ≤ t3Facet06 Y Z := by
  by_cases h0 : Y ≤ (1 / 2 : ℝ)
  · by_cases h1 : Z ≤ (1 / 2 : ℝ)
    · exact t3Facet06_box0 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
    · by_cases h2 : Y ≤ (1 / 4 : ℝ)
      · by_cases h3 : Z ≤ (3 / 4 : ℝ)
        · exact t3Facet06_box2 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
        · exact t3Facet06_box3 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
