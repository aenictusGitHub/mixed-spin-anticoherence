        · exact t3Facet06_box5 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
  · by_cases h1 : Z ≤ (1 / 2 : ℝ)
    · exact t3Facet06_box1 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
    · by_cases h2 : Y ≤ (3 / 4 : ℝ)
      · by_cases h3 : Z ≤ (3 / 4 : ℝ)
        · exact t3Facet06_box6 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
