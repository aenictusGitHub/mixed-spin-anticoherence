set_option maxHeartbeats 0
theorem original_15_0 : ∀ j : Fin 468,
    let kl := QuadraticPairData.pair j
    let z := variableWeight kl.1+variableWeight kl.2+rowShift 0
    0≤z ∧ z<12 →
    quadraticCoefficient (Covariant05.coefficients 15 (Fin.ofNat 12 z.toNat) 0) kl.1.val kl.2.val=
      MomentRhoQData05.original 15 0 kl.1.val kl.2.val := by
  intro j; dsimp only; intro hz
  exact selected_coefficient_of_cached_column (Covariant05.coefficients 15) rowShift
    (by simpa only [rowShift_correct] using BlockCircuits05.original_term_grade 15)
    0 RhoCached05_15_0.originalSource
    ((congrArg (fun F => collapseColumn (F 15) 0) NumericQ05.original_identity).symm.trans RhoCached05_15_0.original_source)
    RhoCached05_15_0.original_valid (MomentRhoQData05.originalRow 15 0)
    RhoCached05_15_0.original_ordered RhoCached05_15_0.original_indices 144 (by decide)
    (fun h => QuadraticBasisCache.packed (h/36) (h%36))
    (fun h => QuadraticBasisCache.bounds (h/36) (h%36))
    QuadraticBasisCache.encoded_packed_correct QuadraticBasisCache.encoded_bounds_correct
    RhoCached05_15_0.original_bound RhoCached05_15_0.original_pack
    (QuadraticPairData.pair j).1 (QuadraticPairData.pair j).2
    (QuadraticPairData.pair_sorted j) hz
