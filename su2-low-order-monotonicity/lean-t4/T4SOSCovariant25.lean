def Q (H : Matrix (Fin 6) (Fin 6) ℂ) (a : Fin 1) : Matrix (Fin 16) (Fin 56) ℂ :=
  evaluatedCovariant (denominators a) (coefficients a) (matrixCoordinates H)

def W (H : Matrix (Fin 6) (Fin 6) ℂ) : Matrix (Fin 56) (Fin 56) ℂ :=
  symWeight H

def contribution (H : Matrix (Fin 6) (Fin 6) ℂ) : ℂ :=
  ∑ a, ∑ b, (Data25.G a b : ℂ) * (W H * (Q H a)ᴴ * outputMetric 15 * Q H b).trace

theorem contribution_nonneg {H : Matrix (Fin 6) (Fin 6) ℂ} (hH : H.PosSemidef) :
    0 ≤ contribution H :=
  real_weighted_sos_nonneg Data25.gram_positive (outputMetric_positive 15)
    (symWeight_positive hH) (Q H)

