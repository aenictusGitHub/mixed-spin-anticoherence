      (908654018560 / 19683 : ℝ) * (Y - (7 / 8 : ℝ))^5 * (Z - (5 / 8 : ℝ))^3 := by
    unfold t3Facet08
    ring
  rw [identity]
  positivity

/-- Every point of the unit square is covered, including box boundaries. -/
theorem t3Facet08_nonneg (Y Z : ℝ)
    (hY0 : 0 ≤ Y) (hY1 : Y ≤ 1) (hZ0 : 0 ≤ Z) (hZ1 : Z ≤ 1) :
    0 ≤ t3Facet08 Y Z := by
  by_cases h0 : Y ≤ (1 / 2 : ℝ)
  · by_cases h1 : Z ≤ (1 / 2 : ℝ)
    · exact t3Facet08_box0 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
    · by_cases h2 : Y ≤ (1 / 4 : ℝ)
      · by_cases h3 : Z ≤ (3 / 4 : ℝ)
        · exact t3Facet08_box2 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
        · exact t3Facet08_box3 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
      · by_cases h3 : Z ≤ (3 / 4 : ℝ)
        · exact t3Facet08_box4 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
        · exact t3Facet08_box5 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
  · by_cases h1 : Z ≤ (1 / 2 : ℝ)
    · exact t3Facet08_box1 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
    · by_cases h2 : Y ≤ (3 / 4 : ℝ)
      · by_cases h3 : Z ≤ (3 / 4 : ℝ)
        · by_cases h4 : Y ≤ (5 / 8 : ℝ)
          · exact t3Facet08_box8 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
          · by_cases h5 : Z ≤ (5 / 8 : ℝ)
            · exact t3Facet08_box9 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
            · exact t3Facet08_box10 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
        · exact t3Facet08_box6 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
      · by_cases h3 : Z ≤ (3 / 4 : ℝ)
        · by_cases h4 : Y ≤ (7 / 8 : ℝ)
          · by_cases h5 : Z ≤ (5 / 8 : ℝ)
            · exact t3Facet08_box11 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
            · exact t3Facet08_box12 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
          · by_cases h5 : Z ≤ (5 / 8 : ℝ)
            · exact t3Facet08_box13 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
            · exact t3Facet08_box14 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
        · exact t3Facet08_box7 Y Z (by linarith) (by linarith) (by linarith) (by linarith)

end
