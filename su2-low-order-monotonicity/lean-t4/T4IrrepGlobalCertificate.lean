private lemma witness_val_ite {P : Nat→Prop} (c : Prop) [Decidable c]
    (x y : {j : Nat // P j}) :
    (if c then x else y).val=(if c then x.val else y.val) := by
  split_ifs <;> rfl

/-- Kernel reduction projects away the leaf proofs and checks every valid
index of the balanced lookup. -/
private lemma blockWitness_index (p : MvPolynomial Nat ℚ) (hp : raising p=0)
    (hseed : ∀ b : Fin 252, ∀ i : Fin (dimension b.val), constraints b.val ≤ i.val →
      MvPolynomial.coeff (monomialExponent (mon b.val i.val)) p=0) :
    ∀ b : Fin 252, (blockWitness p hp hseed b.val).val=b.val := by
  unfold blockWitness
  simp only [witness_val_ite]
  decide +kernel

/-- The formal raising equation and the 687 independent seed coefficients
certify a bounded weight-zero quintic polynomial identically zero. Each block
uses its independently kernel-checked finite-field LU certificate. -/
theorem polynomial_zero_of_invariant_and_seeds (p : MvPolynomial Nat ℚ)
    (hp : raising p=0)
    (hsupport : ∀ d : Nat →₀ Nat, MvPolynomial.coeff d p ≠ 0 →
      Sparse.Exponent.HasGrade 36 (fun h => MomentBasis.variableWeight (Fin.ofNat 36 h)) (5,0) d.toMultiset)
    (hseed : ∀ b : Fin 252, ∀ i : Fin (dimension b.val), constraints b.val ≤ i.val →
      MvPolynomial.coeff (monomialExponent (mon b.val i.val)) p=0) : p=0 := by
  apply polynomial_zero_of_blocks p hsupport
  intro b
  have hc := (blockWitness p hp hseed b.val).property
  rw [blockWitness_index p hp hseed b] at hc
  exact hc

/-- Final global-seed interface: only the 687 certified seed coefficients are
needed in addition to the actual raising and support identities. -/
theorem polynomial_zero_of_invariant_and_global_seeds (p : MvPolynomial Nat ℚ)
    (hp : raising p=0)
    (hsupport : ∀ d : Nat →₀ Nat, MvPolynomial.coeff d p ≠ 0 →
      Sparse.Exponent.HasGrade 36 (fun h => MomentBasis.variableWeight (Fin.ofNat 36 h)) (5,0) d.toMultiset)
    (hseed : ∀ j : Fin 687,
      MvPolynomial.coeff (monomialExponent (MomentSeeds.seed j.val)) p=0) : p=0 :=
  polynomial_zero_of_invariant_and_seeds p hp hsupport (block_seeds_of_global p hseed)

