import T4SOSNumericMoment

namespace LowOrder.T4SOS.QuadraticExpansion

def formRow (h : Nat) : List (Nat × Int) := if h%36<18 then (if h%36<9 then (if h%36<4 then (if h%36<2 then (if h%36<1 then ([(0,210),(2,-900),(6,2250),(12,-3500),(20,3150),(30,-1260)]) else ([(1,180),(5,-900),(11,2100),(19,-2520),(29,1260)])) else (if h%36<3 then ([(4,225),(10,-1050),(18,1890),(28,-1260)]) else ([(9,350),(17,-1260),(27,1260)]))) else (if h%36<6 then (if h%36<5 then ([(16,630),(26,-1260)]) else ([(25,1260)])) else (if h%36<7 then ([(3,-180),(7,900),(13,-2100),(21,2520),(31,-1260)]) else (if h%36<8 then ([(0,42),(2,-108),(6,-90),(12,980),(20,-1890),(30,1260)]) else ([(1,72),(5,-180),(11,-210),(19,1260),(29,-1260)]))))) else (if h%36<13 then (if h%36<11 then (if h%36<10 then ([(4,135),(10,-210),(18,-630),(28,1260)]) else ([(9,280),(27,-1260)])) else (if h%36<12 then ([(16,630),(26,1260)]) else ([(8,225),(14,-1050),(22,1890),(32,-1260)]))) else (if h%36<15 then (if h%36<14 then ([(3,-72),(7,180),(13,210),(21,-1260),(31,1260)]) else ([(0,21),(2,-18),(6,-180),(12,280),(20,630),(30,-1260)])) else (if h%36<16 then ([(1,54),(11,-420),(29,1260)]) else (if h%36<17 then ([(4,135),(10,210),(18,-630),(28,-1260)]) else ([(9,350),(17,1260),(27,1260)])))))) else (if h%36<27 then (if h%36<22 then (if h%36<20 then (if h%36<19 then ([(15,-350),(23,1260),(33,-1260)]) else ([(8,135),(14,-210),(22,-630),(32,1260)])) else (if h%36<21 then ([(3,-54),(13,420),(31,-1260)]) else ([(0,21),(2,18),(6,-180),(12,-280),(20,630),(30,1260)]))) else (if h%36<24 then (if h%36<23 then ([(1,72),(5,180),(11,-210),(19,-1260),(29,-1260)]) else ([(4,225),(10,1050),(18,1890),(28,1260)])) else (if h%36<25 then ([(24,630),(34,-1260)]) else (if h%36<26 then ([(15,-280),(33,1260)]) else ([(8,135),(14,210),(22,-630),(32,-1260)]))))) else (if h%36<31 then (if h%36<29 then (if h%36<28 then ([(3,-72),(7,-180),(13,210),(21,1260),(31,1260)]) else ([(0,42),(2,108),(6,-90),(12,-980),(20,-1890),(30,-1260)])) else (if h%36<30 then ([(1,180),(5,900),(11,2100),(19,2520),(29,1260)]) else ([(35,-1260)]))) else (if h%36<33 then (if h%36<32 then ([(24,630),(34,1260)]) else ([(15,-350),(23,-1260),(33,-1260)])) else (if h%36<34 then ([(8,225),(14,1050),(22,1890),(32,1260)]) else (if h%36<35 then ([(3,-180),(7,-900),(13,-2100),(21,-2520),(31,-1260)]) else ([(0,210),(2,900),(6,2250),(12,3500),(20,3150),(30,1260)]))))))

def productRow (p q : List (Nat × Int)) : List (Nat × Int) :=
  p.flatMap (fun a => q.map (fun b => (36*min a.1 b.1+max a.1 b.1,a.2*b.2)))

def expandedRow (p : List (List Nat × Int)) : List (Nat × Int) :=
  p.flatMap (fun t => (productRow (formRow (t.1.headD 0))
    (formRow ((t.1.drop 1).headD 0))).map (fun a => (a.1,t.2*a.2)))

end LowOrder.T4SOS.QuadraticExpansion
