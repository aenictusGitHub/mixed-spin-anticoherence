theorem table_eq (k l : Nat) :
    ∑a : Fin 17,Transformed00.coefficients a 16 * MomentRhoQData00.original a.val 1 k l=
      MomentRhoQData00.transformed 16 1 k l := by
  have h := IntegerTable.weighted_get_eq_of_cached_pack 256 1296 (by decide) terms
    (fun a => MomentRhoQData00.originalRow a.val 1)
    (MomentRhoQData00.transformedRow 16 1) packed1 bounds1
    (fun a => (cache1_correct a).2.2.2) checked.2.2.2
    (by intro a t ht; exact of_decide_eq_true (List.all_eq_true.mp (cache1_correct a).2.2.1 t ht))
    (by intro t ht; exact of_decide_eq_true (List.all_eq_true.mp checked.2.2.1 t ht))
    (fun a => (cache1_correct a).1) (fun a => (cache1_correct a).2.1)
    checked.2.1 checked.1 (36*k+l)
  simpa only [terms,List.map_map,Function.comp_def,←Fin.sum_univ_def,
    NumericQ00.transform_identity,MomentRhoQData00.original,MomentRhoQData00.transformed] using h
end LowOrder.T4SOS.RhoTransformPacked00.Column16_1
