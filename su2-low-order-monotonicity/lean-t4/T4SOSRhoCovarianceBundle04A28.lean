theorem raising :
    matrixDerivative inputRaising (CovariantLie04.raw 28)=ladderUpper 9*CovariantLie04.raw 28-
      CovariantLie04.raw 28*(SourceLie.Rho.raising.map (Int.castRingHom CoordinatePolynomial)) := by
  have hb : ∀r j t,t∈Covariant04.coefficients 28 r j → ∀h∈t.1,h<36 := by
    intro r j t ht h hh
    have he := List.all_eq_true.mp (CovariantBounds04.original 28 r j) t ht
    exact of_decide_eq_true (List.all_eq_true.mp he h hh)
  have hw : ∀r j t,t∈Covariant04.coefficients 28 r j →
      (t.1.map coordinateWeight).sum=(r.val:Int)-((2)+j.val) := by
    intro r j t ht
    have he := of_decide_eq_true (List.all_eq_true.mp (CovariantWeights04.original 28 r j) t ht)
    change (t.1.map coordinateWeight).sum=(r.val:Int)-CovariantWeights04.rowShift j at he
    have hs : CovariantWeights04.rowShift j=(2:Int)+j.val := by fin_cases j <;> rfl
    rw [hs] at he
    exact he
  have hl := lowering
  rw [SourceLie.Rho.lowering_cast] at hl
