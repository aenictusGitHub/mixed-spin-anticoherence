noncomputable def coefficients : Fin 1 → Matrix (Fin 18) (Fin 70) Polynomial := ![q00]
def Q (H : Matrix (Fin 6) (Fin 6) ℂ) (a : Fin 1) : Matrix (Fin 18) (Fin 70) ℂ :=
  evaluatedCovariant (denominators a) (coefficients a) (matrixCoordinates H)

def W (H : Matrix (Fin 6) (Fin 6) ℂ) : Matrix (Fin 70) (Fin 70) ℂ :=
  mixedWeight H

def contribution (H : Matrix (Fin 6) (Fin 6) ℂ) : ℂ :=
  ∑ a, ∑ b, (Data34.G a b : ℂ) * (W H * (Q H a)ᴴ * outputMetric 17 * Q H b).trace

theorem contribution_nonneg {H : Matrix (Fin 6) (Fin 6) ℂ} (hH : H.PosSemidef) :
    0 ≤ contribution H :=
  real_weighted_sos_nonneg Data34.gram_positive (outputMetric_positive 17)
    (mixedWeight_positive hH) (Q H)

