theorem raising :
    matrixDerivative inputRaising (CovariantLie02.raw 15)=ladderUpper 5*CovariantLie02.raw 15-
      CovariantLie02.raw 15*(SourceLie.Rho.raising.map (Int.castRingHom CoordinatePolynomial)) := by
  have hb : ∀r j t,t∈Covariant02.coefficients 15 r j → ∀h∈t.1,h<36 := by
    intro r j t ht h hh
    have he := List.all_eq_true.mp (CovariantBounds02.original 15 r j) t ht
    exact of_decide_eq_true (List.all_eq_true.mp he h hh)
  have hw : ∀r j t,t∈Covariant02.coefficients 15 r j →
      (t.1.map coordinateWeight).sum=(r.val:Int)-((0)+j.val) := by
    intro r j t ht
    have he := of_decide_eq_true (List.all_eq_true.mp (CovariantWeights02.original 15 r j) t ht)
    change (t.1.map coordinateWeight).sum=(r.val:Int)-CovariantWeights02.rowShift j at he
    have hs : CovariantWeights02.rowShift j=(0:Int)+j.val := by fin_cases j <;> rfl
    rw [hs] at he
    exact he
