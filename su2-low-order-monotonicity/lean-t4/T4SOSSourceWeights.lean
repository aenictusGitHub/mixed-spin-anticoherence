/-- The binomial metric in the rational highest-weight output coordinates. -/
def outputMetric (J : Nat) : Matrix (Fin (J+1)) (Fin (J+1)) ℂ :=
  Matrix.diagonal (fun r => (J.choose r.val : ℂ))

theorem outputMetric_positive (J : Nat) : (outputMetric J).PosSemidef := by
  apply Matrix.PosSemidef.diagonal
  intro r
  change (0 : ℂ) ≤ (J.choose r.val : ℂ)
  exact_mod_cast (Nat.zero_le (J.choose r.val))

end
