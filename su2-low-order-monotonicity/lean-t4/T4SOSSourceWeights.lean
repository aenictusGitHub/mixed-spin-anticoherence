  altBasis*((H ⊗ₖ H) ⊗ₖ H)*altBasisᴴ
theorem altWeight_positive {H : Matrix (Fin 6) (Fin 6) ℂ} (hH : H.PosSemidef) :
  (altWeight H).PosSemidef := compressed_cube_posSemidef hH altBasis

