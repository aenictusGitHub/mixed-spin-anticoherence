  fin_cases i
  · have he : row 0=(NumericMomentAligned28.Column00.inputRows).getD 14 [] := rfl
    rw [he]
    refine moment_row_cache (fun a h=>MomentQData28.original a.val 0 h) _
      NumericMomentAligned28.Column00.input_check ?_ (14 : Fin 27) h
    intro a h hh
    simp only [MomentQData28.original,if_neg (show ¬(0<h ∧ h<25) by omega)]
  · have he : row 1=(NumericMomentAligned28.Column01.inputRows).getD 14 [] := rfl
    rw [he]
    refine moment_row_cache (fun a h=>MomentQData28.original a.val 1 h) _
      NumericMomentAligned28.Column01.input_check ?_ (14 : Fin 27) h
