theorem hinput : ∀ a, alignedPolynomial mons (input a)=Covariant34.coefficients a 0 0 := by decide +kernel
theorem houtput : ∀ c, alignedPolynomial mons (output c)=numerators c 0 0 := by decide +kernel
theorem hcoeff : ∀ c b, output c b=∑ a, coefficients a c*input a b := by decide +kernel
theorem evaluation (x : Nat → ℂ) (c : Fin 1) : eval x (numerators c 0 0)=∑ a, (coefficients a c:ℂ)*eval x (Covariant34.coefficients a 0 0) :=
  aligned_linear_certificate mons (fun a => Covariant34.coefficients a 0 0) (numerators c 0 0) input (output c) (fun a => coefficients a c) hinput (houtput c) (hcoeff c) x
end Entry00_00
