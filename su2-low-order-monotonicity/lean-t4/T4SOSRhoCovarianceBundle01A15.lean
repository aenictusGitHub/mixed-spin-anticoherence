  · exact lowering_03_04
  · exact lowering_03_05
theorem lowering :
    matrixDerivative inputLowering (CovariantLie01.raw 15)=ladderLower 3*CovariantLie01.raw 15-
      CovariantLie01.raw 15*(SourceLie.Rho.lowering.map (Int.castRingHom CoordinatePolynomial)) := by
  have hc (i : Fin 4) (j : Fin 6) :
      eval (MvPolynomial.X : Nat→CoordinatePolynomial)
        (Sparse.rawDerivative Sparse.inputLower (Q i j) ++
          polynomialCombination (SourceLie.Rho.loweringColumns j) (fun h=>Q i h))=
      eval MvPolynomial.X (polynomialCombination (loweringRows i) (fun h=>Q h j)) := by
    have he := RawQuadraticCompressed.eval_zero_of_check 96 (by decide)
      ((i.val:Int)-(-1)-j.val-1) (loweringDifference i j) (lowering_checks i j)
      (MvPolynomial.X : Nat→CoordinatePolynomial)
    unfold loweringDifference at he
    rw [NumericCovariance.derivative_identity] at he
    change eval MvPolynomial.X ((Sparse.rawDerivative Sparse.inputLower (Q i j) ++
      polynomialCombination (SourceLie.Rho.loweringColumns j) (fun h=>Q i h)) ++
      Sparse.scale (-1) (polynomialCombination (loweringRows i) (fun h=>Q h j)))=0 at he
    rw [eval_append,eval_scale] at he
    exact sub_eq_zero.mp (by simpa only [Int.cast_neg,Int.cast_one,neg_one_mul,←sub_eq_add_neg] using he)
  have he := covariant_lie_eval_certificate inputLowering MvPolynomial.X Sparse.inputLower
    inputLowering_variable Q loweringRows SourceLie.Rho.loweringColumns SourceLie.Rho.lowering
    CovariantLie01.loweringRows_valid SourceLie.Rho.loweringColumns_valid
    (fun i j=>SourceLie.Rho.loweringColumns_identity i j) hc
  change matrixDerivative inputLowering (Matrix.map Q (eval MvPolynomial.X))=
    ((rowMatrix CovariantLie01.loweringRows : Matrix (Fin 4) (Fin 4) Int).map (Int.castRingHom CoordinatePolynomial))*
      (Matrix.map Q (eval MvPolynomial.X))-(Matrix.map Q (eval MvPolynomial.X))*
        (SourceLie.Rho.lowering.map (Int.castRingHom CoordinatePolynomial)) at he
  rw [CovariantLie01.loweringRows_identity,Q_identity] at he
  have hm : ((ladderLower 3 : Matrix _ _ Int).map (Int.castRingHom CoordinatePolynomial))=ladderLower 3 := by
    apply Matrix.ext; intro i j; simp only [Matrix.map_apply,ladderLower]
    split <;> simp
  rw [hm] at he
  exact he
lemma raising_first_checks (i : Fin 4) :
    RawQuadraticCompressed.check 96 ((i.val:Int)-(-1)+1) (raisingDifference i 0)=true := by
  fin_cases i
  · exact raising_00_00
  · exact raising_01_00
  · exact raising_02_00
  · exact raising_03_00
lemma raising_first (i : Fin 4) :
    inputRaising (eval (MvPolynomial.X : Nat→CoordinatePolynomial) (Covariant01.coefficients 15 i 0))=
      ((ladderUpper 3 : Matrix (Fin 4) (Fin 4) CoordinatePolynomial) * (Covariant01.coefficients 15).map (eval (MvPolynomial.X : Nat→CoordinatePolynomial))) i 0 := by
  have hc : eval (MvPolynomial.X : Nat→CoordinatePolynomial)
      (Sparse.rawDerivative Sparse.inputRaise (Q i 0) ++
        polynomialCombination (SourceLie.Rho.raisingColumns 0) (fun h=>Q i h))=
    eval MvPolynomial.X (polynomialCombination (raisingRows i) (fun h=>Q h 0)) := by
    have he := RawQuadraticCompressed.eval_zero_of_check 96 (by decide)
      ((i.val:Int)-(-1)+1) (raisingDifference i 0) (raising_first_checks i)
      (MvPolynomial.X : Nat→CoordinatePolynomial)
    unfold raisingDifference at he
    rw [NumericCovariance.derivative_identity] at he
    change eval MvPolynomial.X ((Sparse.rawDerivative Sparse.inputRaise (Q i 0) ++
      polynomialCombination (SourceLie.Rho.raisingColumns 0) (fun h=>Q i h)) ++
      Sparse.scale (-1) (polynomialCombination (raisingRows i) (fun h=>Q h 0)))=0 at he
    rw [eval_append,eval_scale] at he
    exact sub_eq_zero.mp (by simpa only [Int.cast_neg,Int.cast_one,neg_one_mul,←sub_eq_add_neg] using he)
  have he := covariant_lie_entry_eval_certificate inputRaising MvPolynomial.X Sparse.inputRaise
    inputRaising_variable Q raisingRows SourceLie.Rho.raisingColumns SourceLie.Rho.raising
    CovariantLie01.raisingRows_valid SourceLie.Rho.raisingColumns_valid
    (fun i j=>SourceLie.Rho.raisingColumns_identity i j) i 0 hc
  have hu : (rowMatrix raisingRows : Matrix (Fin 4) (Fin 4) Int)=ladderUpper 3 :=
    CovariantLie01.raisingRows_identity
  have hm : ((ladderUpper 3 : Matrix _ _ Int).map (Int.castRingHom CoordinatePolynomial))=ladderUpper 3 := by
    apply Matrix.ext; intro i j; simp only [Matrix.map_apply,ladderUpper]
    split <;> simp
  rw [hu,hm,SourceLie.Rho.raising_cast,right_upper_five_zero,sub_zero,Q_identity] at he
  exact he
theorem raising :
    matrixDerivative inputRaising (CovariantLie01.raw 15)=ladderUpper 3*CovariantLie01.raw 15-
      CovariantLie01.raw 15*(SourceLie.Rho.raising.map (Int.castRingHom CoordinatePolynomial)) := by
  have hb : ∀r j t,t∈Covariant01.coefficients 15 r j → ∀h∈t.1,h<36 := by
    intro r j t ht h hh
    have he := List.all_eq_true.mp (CovariantBounds01.original 15 r j) t ht
    exact of_decide_eq_true (List.all_eq_true.mp he h hh)
  have hw : ∀r j t,t∈Covariant01.coefficients 15 r j →
      (t.1.map coordinateWeight).sum=(r.val:Int)-((-1)+j.val) := by
    intro r j t ht
    have he := of_decide_eq_true (List.all_eq_true.mp (CovariantWeights01.original 15 r j) t ht)
    change (t.1.map coordinateWeight).sum=(r.val:Int)-CovariantWeights01.rowShift j at he
    have hs : CovariantWeights01.rowShift j=(-1:Int)+j.val := by fin_cases j <;> rfl
    rw [hs] at he
    exact he
  have hl := lowering
  rw [SourceLie.Rho.lowering_cast] at hl
  have he := rho_raising_of_lowering 3 (-1) (by decide)
    (Covariant01.coefficients 15) hb hw (rho_ladder_commutator 1) hl raising_first
  rw [SourceLie.Rho.raising_cast]
  exact he
end
