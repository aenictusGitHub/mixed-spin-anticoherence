theorem raising :
    matrixDerivative inputRaising (CovariantLie05.raw 8)=ladderUpper 11*CovariantLie05.raw 8-
      CovariantLie05.raw 8*(SourceLie.Rho.raising.map (Int.castRingHom CoordinatePolynomial)) := by
  have hb : ∀r j t,t∈Covariant05.coefficients 8 r j → ∀h∈t.1,h<36 := by
