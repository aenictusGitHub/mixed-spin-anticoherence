    (fun a => MomentRhoQData05.originalRow a.val 2)
    (MomentRhoQData05.transformedRow 18 2) packed2 bounds2
    (fun a => (cache2_correct a).2.2.2) checked.2.2.2
    (by intro a t ht; exact of_decide_eq_true (List.all_eq_true.mp (cache2_correct a).2.2.1 t ht))
    (by intro t ht; exact of_decide_eq_true (List.all_eq_true.mp checked.2.2.1 t ht))
    (fun a => (cache2_correct a).1) (fun a => (cache2_correct a).2.1)
    checked.2.1 checked.1 (36*k+l)
  simpa only [terms,List.map_map,Function.comp_def,←Fin.sum_univ_def,
    NumericQ05.transform_identity,MomentRhoQData05.original,MomentRhoQData05.transformed] using h
end LowOrder.T4SOS.RhoTransformPacked05.Column18_2
