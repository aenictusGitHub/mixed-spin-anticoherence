theorem t4Box045Denominator : ∀ i j,0<t4Box045B 4 i j := by
  decide +kernel

theorem t4Box045Control : ∀ i j,rationalHullCertificate t4QHullVertex
    (t4ControlPoint t4Box045B i j) (t4Box045Ids i j) (t4Box045Weights i j) := by
  decide +kernel

theorem t4Box045Hull (Y Z : ℝ)
    (hY : (15/16)≤Y ∧ Y≤(31/32)) (hZ : (1/8)≤Z ∧ Z≤(5/32)) :
    (fun r : Fin 4 => t4PowerPolynomial r.castSucc Y Z/t4PowerPolynomial 4 Y Z)
      ∈ convexHull ℝ (Set.range t4HullVertex) := by
  apply t4Bernstein_box_hull_on_rectangle t4Box045B t4Box045Ids t4Box045Weights
    30 1 4 1 32 32
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    t4Box045Identity t4Box045Denominator t4Box045Control Y Z
  · norm_num at hY ⊢
    exact hY
  · norm_num at hZ ⊢
    exact hZ

end
end SU2T2.Spin
