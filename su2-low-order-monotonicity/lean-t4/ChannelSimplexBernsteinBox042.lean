theorem t4Box042Identity : ∀ r : Fin 5,
    (bivarSourceCircuit (t4PowerCoeff r) 7 1 0 1 8 8).compile=
      (bivarBernsteinCircuit (t4Box042B r)).compile := by
  intro r
  fin_cases r <;> decide +kernel

theorem t4Box042Denominator : ∀ i j,0<t4Box042B 4 i j := by
  decide +kernel

theorem t4Box042Control : ∀ i j,rationalHullCertificate t4QHullVertex
    (t4ControlPoint t4Box042B i j) (t4Box042Ids i j) (t4Box042Weights i j) := by
  decide +kernel

theorem t4Box042Hull (Y Z : ℝ)
    (hY : (7/8)≤Y ∧ Y≤(1)) (hZ : (0)≤Z ∧ Z≤(1/8)) :
    (fun r : Fin 4 => t4PowerPolynomial r.castSucc Y Z/t4PowerPolynomial 4 Y Z)
      ∈ convexHull ℝ (Set.range t4HullVertex) := by
  apply t4Bernstein_box_hull_on_rectangle t4Box042B t4Box042Ids t4Box042Weights
    7 1 0 1 8 8
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    t4Box042Identity t4Box042Denominator t4Box042Control Y Z
  · norm_num at hY ⊢
    exact hY
  · norm_num at hZ ⊢
    exact hZ

end
end SU2T2.Spin
