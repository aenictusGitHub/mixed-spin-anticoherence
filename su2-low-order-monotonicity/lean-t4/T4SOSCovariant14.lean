noncomputable def coefficients : Fin 7 → Matrix (Fin 12) (Fin 20) Polynomial := ![q00,q01,q02,q03,q04,q05,q06]
def Q (H : Matrix (Fin 6) (Fin 6) ℂ) (a : Fin 7) : Matrix (Fin 12) (Fin 20) ℂ :=
  evaluatedCovariant (denominators a) (coefficients a) (matrixCoordinates H)

def W (H : Matrix (Fin 6) (Fin 6) ℂ) : Matrix (Fin 20) (Fin 20) ℂ :=
  altWeight H

def contribution (H : Matrix (Fin 6) (Fin 6) ℂ) : ℂ :=
  ∑ a, ∑ b, (Data14.G a b : ℂ) * (W H * (Q H a)ᴴ * outputMetric 11 * Q H b).trace

theorem contribution_nonneg {H : Matrix (Fin 6) (Fin 6) ℂ} (hH : H.PosSemidef) :
    0 ≤ contribution H :=
  real_weighted_sos_nonneg Data14.gram_positive (outputMetric_positive 11)
    (altWeight_positive hH) (Q H)

end
