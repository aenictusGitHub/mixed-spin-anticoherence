lemma raising_first (i : Fin 4) :
    inputRaising (eval (MvPolynomial.X : Nat→CoordinatePolynomial) (Covariant01.coefficients 13 i 0))=
      ((ladderUpper 3 : Matrix (Fin 4) (Fin 4) CoordinatePolynomial) * (Covariant01.coefficients 13).map (eval (MvPolynomial.X : Nat→CoordinatePolynomial))) i 0 := by
  have hc : eval (MvPolynomial.X : Nat→CoordinatePolynomial)
      (Sparse.rawDerivative Sparse.inputRaise (Q i 0) ++
        polynomialCombination (SourceLie.Rho.raisingColumns 0) (fun h=>Q i h))=
    eval MvPolynomial.X (polynomialCombination (raisingRows i) (fun h=>Q h 0)) := by
    have he := RawQuadraticCompressed.eval_zero_of_check 96 (by decide)
      ((i.val:Int)-(-1)+1) (raisingDifference i 0) (raising_first_checks i)
      (MvPolynomial.X : Nat→CoordinatePolynomial)
    unfold raisingDifference at he
    rw [NumericCovariance.derivative_identity] at he
    change eval MvPolynomial.X ((Sparse.rawDerivative Sparse.inputRaise (Q i 0) ++
      polynomialCombination (SourceLie.Rho.raisingColumns 0) (fun h=>Q i h)) ++
      Sparse.scale (-1) (polynomialCombination (raisingRows i) (fun h=>Q h 0)))=0 at he
    rw [eval_append,eval_scale] at he
    exact sub_eq_zero.mp (by simpa only [Int.cast_neg,Int.cast_one,neg_one_mul,←sub_eq_add_neg] using he)
  have he := covariant_lie_entry_eval_certificate inputRaising MvPolynomial.X Sparse.inputRaise
    inputRaising_variable Q raisingRows SourceLie.Rho.raisingColumns SourceLie.Rho.raising
    CovariantLie01.raisingRows_valid SourceLie.Rho.raisingColumns_valid
    (fun i j=>SourceLie.Rho.raisingColumns_identity i j) i 0 hc
  have hu : (rowMatrix raisingRows : Matrix (Fin 4) (Fin 4) Int)=ladderUpper 3 :=
    CovariantLie01.raisingRows_identity
  have hm : ((ladderUpper 3 : Matrix _ _ Int).map (Int.castRingHom CoordinatePolynomial))=ladderUpper 3 := by
    apply Matrix.ext; intro i j; simp only [Matrix.map_apply,ladderUpper]
    split <;> simp
  rw [hu,hm,SourceLie.Rho.raising_cast,right_upper_five_zero,sub_zero,Q_identity] at he
  exact he
theorem raising :
    matrixDerivative inputRaising (CovariantLie01.raw 13)=ladderUpper 3*CovariantLie01.raw 13-
      CovariantLie01.raw 13*(SourceLie.Rho.raising.map (Int.castRingHom CoordinatePolynomial)) := by
  have hb : ∀r j t,t∈Covariant01.coefficients 13 r j → ∀h∈t.1,h<36 := by
    intro r j t ht h hh
    have he := List.all_eq_true.mp (CovariantBounds01.original 13 r j) t ht
    exact of_decide_eq_true (List.all_eq_true.mp he h hh)
  have hw : ∀r j t,t∈Covariant01.coefficients 13 r j →
      (t.1.map coordinateWeight).sum=(r.val:Int)-((-1)+j.val) := by
    intro r j t ht
    have he := of_decide_eq_true (List.all_eq_true.mp (CovariantWeights01.original 13 r j) t ht)
    change (t.1.map coordinateWeight).sum=(r.val:Int)-CovariantWeights01.rowShift j at he
    have hs : CovariantWeights01.rowShift j=(-1:Int)+j.val := by fin_cases j <;> rfl
    rw [hs] at he
    exact he
  have hl := lowering
  rw [SourceLie.Rho.lowering_cast] at hl
  have he := rho_raising_of_lowering 3 (-1) (by decide)
    (Covariant01.coefficients 13) hb hw (rho_ladder_commutator 1) hl raising_first
  rw [SourceLie.Rho.raising_cast]
  exact he
end
