lemma Q_identity : Q=Covariant01.coefficients 13 := rfl
lemma lowering_checks (i : Fin 4) (j : Fin 6) :
    RawQuadraticCompressed.check 96 ((i.val:Int)-(-1)-j.val-1) (loweringDifference i j)=true := by
  fin_cases i <;> fin_cases j
  · exact lowering_00_00
  · exact lowering_00_01
  · exact lowering_00_02
  · exact lowering_00_03
  · exact lowering_00_04
  · exact lowering_00_05
  · exact lowering_01_00
