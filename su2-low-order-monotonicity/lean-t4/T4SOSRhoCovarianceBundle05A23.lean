      CovariantLie05.raw 23*(SourceLie.Rho.raising.map (Int.castRingHom CoordinatePolynomial)) := by
  have hb : ∀r j t,t∈Covariant05.coefficients 23 r j → ∀h∈t.1,h<36 := by
