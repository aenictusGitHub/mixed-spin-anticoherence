theorem t4Box046Denominator : ∀ i j,0<t4Box046B 4 i j := by
  decide +kernel

theorem t4Box046Control : ∀ i j,rationalHullCertificate t4QHullVertex
    (t4ControlPoint t4Box046B i j) (t4Box046Ids i j) (t4Box046Weights i j) := by
  decide +kernel

theorem t4Box046Hull (Y Z : ℝ)
    (hY : (15/16)≤Y ∧ Y≤(31/32)) (hZ : (5/32)≤Z ∧ Z≤(3/16)) :
    (fun r : Fin 4 => t4PowerPolynomial r.castSucc Y Z/t4PowerPolynomial 4 Y Z)
      ∈ convexHull ℝ (Set.range t4HullVertex) := by
  apply t4Bernstein_box_hull_on_rectangle t4Box046B t4Box046Ids t4Box046Weights
    30 1 5 1 32 32
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    t4Box046Identity t4Box046Denominator t4Box046Control Y Z
  · norm_num at hY ⊢
    exact hY
  · norm_num at hZ ⊢
    exact hZ

end
