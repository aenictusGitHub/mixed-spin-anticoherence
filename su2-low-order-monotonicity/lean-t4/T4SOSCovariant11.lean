def Q (H : Matrix (Fin 6) (Fin 6) ℂ) (a : Fin 11) : Matrix (Fin 6) (Fin 20) ℂ :=
  evaluatedCovariant (denominators a) (coefficients a) (matrixCoordinates H)

def W (H : Matrix (Fin 6) (Fin 6) ℂ) : Matrix (Fin 20) (Fin 20) ℂ :=
  altWeight H

def contribution (H : Matrix (Fin 6) (Fin 6) ℂ) : ℂ :=
  ∑ a, ∑ b, (Data11.G a b : ℂ) * (W H * (Q H a)ᴴ * outputMetric 5 * Q H b).trace

theorem contribution_nonneg {H : Matrix (Fin 6) (Fin 6) ℂ} (hH : H.PosSemidef) :
    0 ≤ contribution H :=
  real_weighted_sos_nonneg Data11.gram_positive (outputMetric_positive 5)
    (altWeight_positive hH) (Q H)

end
