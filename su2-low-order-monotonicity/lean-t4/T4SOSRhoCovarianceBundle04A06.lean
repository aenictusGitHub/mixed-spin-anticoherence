theorem raising :
    matrixDerivative inputRaising (CovariantLie04.raw 6)=ladderUpper 9*CovariantLie04.raw 6-
      CovariantLie04.raw 6*(SourceLie.Rho.raising.map (Int.castRingHom CoordinatePolynomial)) := by
  have hb : ∀r j t,t∈Covariant04.coefficients 6 r j → ∀h∈t.1,h<36 := by
    intro r j t ht h hh
