import T4SOSPositivity
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
namespace LowOrder.T4SOS.Data24
open Matrix
open scoped MatrixOrder
noncomputable section
abbrev Idx := Fin 3
def L : Matrix Idx Idx ℚ := !![(7131239301 / 500000000000), 0, 0;
(-3213200483 / 500000000000), (23590699677 / 1000000000000), 0;
(-4137754771 / 1000000000000), (412926191 / 250000000000), (1559502971 / 100000000000)]
def U : Matrix Idx Idx ℚ := !![(500000000000 / 7131239301), (3213200483000000000000 / 168230924674710405777), (4349900652440925347150000000000 / 262356626844288086373847063467);
0, (1000000000000 / 23590699677), (-165170476400000000000 / 36789766234250240367);
0, 0, (100000000000 / 1559502971)]
def E : Matrix Idx Idx ℚ := !![( / ), 0, ( / );
0, (- / ), 0;
( / ), 0, ( / )]
lemma inverse_identity : U*Lᵀ=1 := by decide +kernel
lemma correction_symmetric : Eᵀ=E := by decide +kernel
lemma inverse_entry_bound : ∀ i j, |U i j| ≤ (100 : ℚ) := by decide +kernel
lemma correction_entry_bound : ∀ i j, |E i j| ≤ (1/1099511627776 : ℚ) := by decide +kernel
def G : Matrix Idx Idx ℝ := (Rat.castHom ℝ).mapMatrix (L*Lᵀ+E)
theorem gram_positive : G.PosSemidef :=
  rational_gram_certificate_entry L U E inverse_identity correction_symmetric
    inverse_entry_bound correction_entry_bound (by norm_num [Idx])
end
end LowOrder.T4SOS.Data24
#print axioms LowOrder.T4SOS.Data24.gram_positive
