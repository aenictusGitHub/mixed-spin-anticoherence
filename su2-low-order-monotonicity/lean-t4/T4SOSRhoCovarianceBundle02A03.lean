lemma lowering_checks (i : Fin 6) (j : Fin 6) :
    RawQuadraticCompressed.check 96 ((i.val:Int)-(0)-j.val-1) (loweringDifference i j)=true := by
  fin_cases i <;> fin_cases j
  · exact lowering_00_00
  · exact lowering_00_01
