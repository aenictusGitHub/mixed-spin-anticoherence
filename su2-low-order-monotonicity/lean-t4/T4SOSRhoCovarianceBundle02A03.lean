lemma raising_first (i : Fin 6) :
    inputRaising (eval (MvPolynomial.X : Nat→CoordinatePolynomial) (Covariant02.coefficients 3 i 0))=
      ((ladderUpper 5 : Matrix (Fin 6) (Fin 6) CoordinatePolynomial) * (Covariant02.coefficients 3).map (eval (MvPolynomial.X : Nat→CoordinatePolynomial))) i 0 := by
  have hc : eval (MvPolynomial.X : Nat→CoordinatePolynomial)
      (Sparse.rawDerivative Sparse.inputRaise (Q i 0) ++
        polynomialCombination (SourceLie.Rho.raisingColumns 0) (fun h=>Q i h))=
    eval MvPolynomial.X (polynomialCombination (raisingRows i) (fun h=>Q h 0)) := by
    have he := RawQuadraticCompressed.eval_zero_of_check 96 (by decide)
      ((i.val:Int)-(0)+1) (raisingDifference i 0) (raising_first_checks i)
      (MvPolynomial.X : Nat→CoordinatePolynomial)
    unfold raisingDifference at he
    rw [NumericCovariance.derivative_identity] at he
    change eval MvPolynomial.X ((Sparse.rawDerivative Sparse.inputRaise (Q i 0) ++
      polynomialCombination (SourceLie.Rho.raisingColumns 0) (fun h=>Q i h)) ++
      Sparse.scale (-1) (polynomialCombination (raisingRows i) (fun h=>Q h 0)))=0 at he
    rw [eval_append,eval_scale] at he
    exact sub_eq_zero.mp (by simpa only [Int.cast_neg,Int.cast_one,neg_one_mul,←sub_eq_add_neg] using he)
  have he := covariant_lie_entry_eval_certificate inputRaising MvPolynomial.X Sparse.inputRaise
    inputRaising_variable Q raisingRows SourceLie.Rho.raisingColumns SourceLie.Rho.raising
    CovariantLie02.raisingRows_valid SourceLie.Rho.raisingColumns_valid
    (fun i j=>SourceLie.Rho.raisingColumns_identity i j) i 0 hc
  have hu : (rowMatrix raisingRows : Matrix (Fin 6) (Fin 6) Int)=ladderUpper 5 :=
    CovariantLie02.raisingRows_identity
  have hm : ((ladderUpper 5 : Matrix _ _ Int).map (Int.castRingHom CoordinatePolynomial))=ladderUpper 5 := by
    apply Matrix.ext; intro i j; simp only [Matrix.map_apply,ladderUpper]
    split <;> simp
  rw [hu,hm,SourceLie.Rho.raising_cast,right_upper_five_zero,sub_zero,Q_identity] at he
  exact he
theorem raising :
    matrixDerivative inputRaising (CovariantLie02.raw 3)=ladderUpper 5*CovariantLie02.raw 3-
      CovariantLie02.raw 3*(SourceLie.Rho.raising.map (Int.castRingHom CoordinatePolynomial)) := by
  have hb : ∀r j t,t∈Covariant02.coefficients 3 r j → ∀h∈t.1,h<36 := by
    intro r j t ht h hh
    have he := List.all_eq_true.mp (CovariantBounds02.original 3 r j) t ht
    exact of_decide_eq_true (List.all_eq_true.mp he h hh)
  have hw : ∀r j t,t∈Covariant02.coefficients 3 r j →
      (t.1.map coordinateWeight).sum=(r.val:Int)-((0)+j.val) := by
    intro r j t ht
    have he := of_decide_eq_true (List.all_eq_true.mp (CovariantWeights02.original 3 r j) t ht)
    change (t.1.map coordinateWeight).sum=(r.val:Int)-CovariantWeights02.rowShift j at he
    have hs : CovariantWeights02.rowShift j=(0:Int)+j.val := by fin_cases j <;> rfl
    rw [hs] at he
    exact he
  have hl := lowering
  rw [SourceLie.Rho.lowering_cast] at hl
  have he := rho_raising_of_lowering 5 (0) (by decide)
    (Covariant02.coefficients 3) hb hw (rho_ladder_commutator 2) hl raising_first
  rw [SourceLie.Rho.raising_cast]
  exact he
