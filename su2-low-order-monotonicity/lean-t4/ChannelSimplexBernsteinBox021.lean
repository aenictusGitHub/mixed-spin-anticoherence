    (t4ControlPoint t4Box021B i j) (t4Box021Ids i j) (t4Box021Weights i j) := by
  decide +kernel

theorem t4Box021Hull (Y Z : ℝ)
    (hY : (0)≤Y ∧ Y≤(1/8)) (hZ : (7/8)≤Z ∧ Z≤(1)) :
    (fun r : Fin 4 => t4PowerPolynomial r.castSucc Y Z/t4PowerPolynomial 4 Y Z)
      ∈ convexHull ℝ (Set.range t4HullVertex) := by
  apply t4Bernstein_box_hull_on_rectangle t4Box021B t4Box021Ids t4Box021Weights
    0 1 7 1 8 8
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    t4Box021Identity t4Box021Denominator t4Box021Control Y Z
  · norm_num at hY ⊢
    exact hY
  · norm_num at hZ ⊢
    exact hZ

end
