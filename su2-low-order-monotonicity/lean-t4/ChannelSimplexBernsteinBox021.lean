theorem t4Box021Identity : ∀ r : Fin 5,
    (bivarSourceCircuit (t4PowerCoeff r) 0 1 7 1 8 8).compile=
      (bivarBernsteinCircuit (t4Box021B r)).compile := by
  intro r
  fin_cases r <;> decide +kernel

