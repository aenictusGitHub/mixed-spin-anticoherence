    ((rowMatrix CovariantLie02.loweringRows : Matrix (Fin 6) (Fin 6) Int).map (Int.castRingHom CoordinatePolynomial))*
      (Matrix.map Q (eval MvPolynomial.X))-(Matrix.map Q (eval MvPolynomial.X))*
