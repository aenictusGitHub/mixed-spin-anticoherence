def t4FacetValue (i : Fin 161) (x y z u : ℝ) : ℝ :=
  t4HullFacet i 0*x+t4HullFacet i 1*y+t4HullFacet i 2*z+t4HullFacet i 3*u+t4HullFacet i 4

def t4FacetRatio (i : Fin 161) (x y z u : ℝ) : ℝ :=
  t4FacetValue i x y z u/t4HullFacet i 4

lemma t4HullFacet_constant_pos (i : Fin 161) : 0<t4HullFacet i 4 := by
  fin_cases i <;> norm_num [t4HullFacet]

lemma t4Origin_mem_hull : (0 : Fin 4 → ℝ) ∈ convexHull ℝ (Set.range t4HullVertex) := by
  apply mem_convexHull_of_exists_fintype (ι := Fin 5)
    ![(561/8600:ℝ),2909/51600,119/430,343/1290,231/688]
    ![t4HullVertex 0,t4HullVertex 1,t4HullVertex 8,t4HullVertex 9,t4HullVertex 23]
  · intro i
    fin_cases i <;> dsimp <;> norm_num
  · simp only [Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
    dsimp
    norm_num
  · intro i
    fin_cases i
    · exact ⟨0,rfl⟩
    · exact ⟨1,rfl⟩
    · exact ⟨8,rfl⟩
    · exact ⟨9,rfl⟩
    · exact ⟨23,rfl⟩
  · simp only [Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
    ext i
    fin_cases i <;> dsimp [t4HullVertex] <;> norm_num

lemma t4Simplex_mem_hull (x y z u : ℝ) (a b c d : Fin 34) (w : Fin 5 → ℝ)
    (hw : ∀ i, 0≤w i) (hs : ∑ i,w i=1)
    (he : ∑ i,w i • (![0,t4HullVertex a,t4HullVertex b,t4HullVertex c,t4HullVertex d] i)
      = ![x,y,z,u]) : ![x,y,z,u] ∈ convexHull ℝ (Set.range t4HullVertex) := by
  rw [←he]
  apply (convex_convexHull ℝ (Set.range t4HullVertex)).sum_mem
    (fun i _ => hw i) hs
  intro i _
  fin_cases i
  · exact t4Origin_mem_hull
  all_goals exact subset_convexHull ℝ (Set.range t4HullVertex) ⟨_,rfl⟩

end
