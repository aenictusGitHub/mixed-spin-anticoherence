    CovariantLie06.raisingRows_valid SourceLie.Rho.raisingColumns_valid
    (fun i j=>SourceLie.Rho.raisingColumns_identity i j) i 0 hc
  have hu : (rowMatrix raisingRows : Matrix (Fin 14) (Fin 14) Int)=ladderUpper 13 :=
