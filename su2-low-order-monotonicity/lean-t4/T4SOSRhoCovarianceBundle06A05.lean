theorem raising :
    matrixDerivative inputRaising (CovariantLie06.raw 5)=ladderUpper 13*CovariantLie06.raw 5-
      CovariantLie06.raw 5*(SourceLie.Rho.raising.map (Int.castRingHom CoordinatePolynomial)) := by
  have hb : ∀r j t,t∈Covariant06.coefficients 5 r j → ∀h∈t.1,h<36 := by
    intro r j t ht h hh
    have he := List.all_eq_true.mp (CovariantBounds06.original 5 r j) t ht
    exact of_decide_eq_true (List.all_eq_true.mp he h hh)
  have hw : ∀r j t,t∈Covariant06.coefficients 5 r j →
      (t.1.map coordinateWeight).sum=(r.val:Int)-((4)+j.val) := by
    intro r j t ht
    have he := of_decide_eq_true (List.all_eq_true.mp (CovariantWeights06.original 5 r j) t ht)
    change (t.1.map coordinateWeight).sum=(r.val:Int)-CovariantWeights06.rowShift j at he
    have hs : CovariantWeights06.rowShift j=(4:Int)+j.val := by fin_cases j <;> rfl
    rw [hs] at he
    exact he
