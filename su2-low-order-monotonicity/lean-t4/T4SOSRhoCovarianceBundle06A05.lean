  have hm : ((ladderUpper 13 : Matrix _ _ Int).map (Int.castRingHom CoordinatePolynomial))=ladderUpper 13 := by
    apply Matrix.ext; intro i j; simp only [Matrix.map_apply,ladderUpper]
