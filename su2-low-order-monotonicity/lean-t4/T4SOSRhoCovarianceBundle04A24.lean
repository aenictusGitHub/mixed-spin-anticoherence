theorem raising :
    matrixDerivative inputRaising (CovariantLie04.raw 24)=ladderUpper 9*CovariantLie04.raw 24-
      CovariantLie04.raw 24*(SourceLie.Rho.raising.map (Int.castRingHom CoordinatePolynomial)) := by
  have hb : ∀r j t,t∈Covariant04.coefficients 24 r j → ∀h∈t.1,h<36 := by
