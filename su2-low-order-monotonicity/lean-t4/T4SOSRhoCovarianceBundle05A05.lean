theorem raising :
    matrixDerivative inputRaising (CovariantLie05.raw 5)=ladderUpper 11*CovariantLie05.raw 5-
      CovariantLie05.raw 5*(SourceLie.Rho.raising.map (Int.castRingHom CoordinatePolynomial)) := by
  have hb : ∀r j t,t∈Covariant05.coefficients 5 r j → ∀h∈t.1,h<36 := by
    intro r j t ht h hh
    have he := List.all_eq_true.mp (CovariantBounds05.original 5 r j) t ht
    exact of_decide_eq_true (List.all_eq_true.mp he h hh)
  have hw : ∀r j t,t∈Covariant05.coefficients 5 r j →
      (t.1.map coordinateWeight).sum=(r.val:Int)-((3)+j.val) := by
    intro r j t ht
    have he := of_decide_eq_true (List.all_eq_true.mp (CovariantWeights05.original 5 r j) t ht)
    change (t.1.map coordinateWeight).sum=(r.val:Int)-CovariantWeights05.rowShift j at he
    have hs : CovariantWeights05.rowShift j=(3:Int)+j.val := by fin_cases j <;> rfl
    rw [hs] at he
    exact he
  have hl := lowering
  rw [SourceLie.Rho.lowering_cast] at hl
  have he := rho_raising_of_lowering 11 (3) (by decide)
    (Covariant05.coefficients 5) hb hw (rho_ladder_commutator 5) hl raising_first
  rw [SourceLie.Rho.raising_cast]
