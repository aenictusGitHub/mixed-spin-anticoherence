    CovariantLie05.loweringRows_valid SourceLie.Rho.loweringColumns_valid
    (fun i j=>SourceLie.Rho.loweringColumns_identity i j) hc
  change matrixDerivative inputLowering (Matrix.map Q (eval MvPolynomial.X))=
    ((rowMatrix CovariantLie05.loweringRows : Matrix (Fin 12) (Fin 12) Int).map (Int.castRingHom CoordinatePolynomial))*
      (Matrix.map Q (eval MvPolynomial.X))-(Matrix.map Q (eval MvPolynomial.X))*
        (SourceLie.Rho.lowering.map (Int.castRingHom CoordinatePolynomial)) at he
  rw [CovariantLie05.loweringRows_identity,Q_identity] at he
  have hm : ((ladderLower 11 : Matrix _ _ Int).map (Int.castRingHom CoordinatePolynomial))=ladderLower 11 := by
