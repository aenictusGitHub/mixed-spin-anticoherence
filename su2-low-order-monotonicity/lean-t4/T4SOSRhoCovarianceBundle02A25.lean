    matrixDerivative inputLowering (CovariantLie02.raw 25)=ladderLower 5*CovariantLie02.raw 25-
      CovariantLie02.raw 25*(SourceLie.Rho.lowering.map (Int.castRingHom CoordinatePolynomial)) := by
  have hc (i : Fin 6) (j : Fin 6) :
      eval (MvPolynomial.X : Nat→CoordinatePolynomial)
