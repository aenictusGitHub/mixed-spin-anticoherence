namespace LowOrder.T4SOS.Data15
open Matrix
open scoped MatrixOrder
noncomputable section
abbrev Idx := Fin 4
def L : Matrix Idx Idx ℚ := !![(5961600253 / 100000000000), 0, 0, 0;
(4237023893 / 500000000000), (50001528613 / 1000000000000), 0, 0;
(562869497 / 125000000000), (18598861081 / 1000000000000), (3560044827 / 100000000000), 0;
(20617380759 / 1000000000000), (2251485273 / 1000000000000), (-4209907739 / 500000000000), (19798102181 / 1000000000000)]
def U : Matrix Idx Idx ℚ := !![(100000000000 / 5961600253), (-847404778600000000000 / 298089125629647539089), (-225156815038245748740000000000 / 353736883227593279789024914201), (-121966758804973983565182484757820000000000 / 7003318959328356831972037373706155972381);
0, (1000000000000 / 50001528613), (-1859886108100000000000 / 178007683280803134951), (-1821175872269837995600000000000 / 271093407892032752423463879087);
0, 0, (100000000000 / 3560044827), (841981547800000000000 / 70482131253886467687);
0, 0, 0, (1000000000000 / 19798102181)]
def E : Matrix Idx Idx ℚ := !![(- / ), (- / ), 0, 0;
(- / ), ( / ), ( / ), 0;
0, ( / ), (- / ), (- / );
0, 0, (- / ), (- / )]
lemma inverse_identity : U*Lᵀ=1 := by decide +kernel
lemma correction_symmetric : Eᵀ=E := by decide +kernel
lemma inverse_entry_bound : ∀ i j, |U i j| ≤ (100 : ℚ) := by decide +kernel
lemma correction_entry_bound : ∀ i j, |E i j| ≤ (1/1099511627776 : ℚ) := by decide +kernel
def G : Matrix Idx Idx ℝ := (Rat.castHom ℝ).mapMatrix (L*Lᵀ+E)
theorem gram_positive : G.PosSemidef :=
  rational_gram_certificate_entry L U E inverse_identity correction_symmetric
    inverse_entry_bound correction_entry_bound (by norm_num [Idx])
end
end LowOrder.T4SOS.Data15
