/-- Every point of the unit square is covered, including box boundaries. -/
theorem t3Facet12_nonneg (Y Z : ℝ)
    (hY0 : 0 ≤ Y) (hY1 : Y ≤ 1) (hZ0 : 0 ≤ Z) (hZ1 : Z ≤ 1) :
    0 ≤ t3Facet12 Y Z := by
  by_cases h0 : Y ≤ (1 / 2 : ℝ)
  · by_cases h1 : Z ≤ (1 / 2 : ℝ)
    · exact t3Facet12_box0 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
    · exact t3Facet12_box1 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
  · by_cases h1 : Z ≤ (1 / 2 : ℝ)
    · exact t3Facet12_box2 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
    · exact t3Facet12_box3 Y Z (by linarith) (by linarith) (by linarith) (by linarith)

end
