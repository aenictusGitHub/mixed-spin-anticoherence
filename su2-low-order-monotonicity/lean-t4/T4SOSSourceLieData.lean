def upper216 (i : Fin 216) : List (Nat × Int) := (if (i.val/36) < 5 then [(i.val+36,((5-(i.val/36):Nat):Int))] else []) ++ (if ((i.val/6)%6) < 5 then [(i.val+6,((5-((i.val/6)%6):Nat):Int))] else []) ++ (if (i.val%6) < 5 then [(i.val+1,((5-(i.val%6):Nat):Int))] else [])
def lower216 (i : Fin 216) : List (Nat × Int) := (if 0 < (i.val/36) then [(i.val-36,((i.val/36:Nat):Int))] else []) ++ (if 0 < ((i.val/6)%6) then [(i.val-6,(((i.val/6)%6:Nat):Int))] else []) ++ (if 0 < (i.val%6) then [(i.val-1,((i.val%6:Nat):Int))] else [])
