def raisingRows : Fin 2 → List (Nat×Int) := ![[(1,1)],[]]
def loweringRows : Fin 2 → List (Nat×Int) := ![[],[(0,1)]]
def raisingDifference (i : Fin 2) (j : Fin 6) : Polynomial :=
  rawDerivative inputRaise (Q i j) ++
  polynomialCombination (NumericSourceLie.Rho.raisingColumns j) (fun h=>Q i h) ++
  scale (-1) (polynomialCombination (raisingRows i) (fun h=>Q h j))
def loweringDifference (i : Fin 2) (j : Fin 6) : Polynomial :=
  rawDerivative inputLower (Q i j) ++
  polynomialCombination (NumericSourceLie.Rho.loweringColumns j) (fun h=>Q i h) ++
  scale (-1) (polynomialCombination (loweringRows i) (fun h=>Q h j))
