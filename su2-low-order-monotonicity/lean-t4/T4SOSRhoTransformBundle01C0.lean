-- From T4SOSRhoTransformCorrect01_00_0
namespace LowOrder.T4SOS.RhoTransformPacked01.Column00_0
open scoped BigOperators
set_option maxHeartbeats 0
set_option maxRecDepth 1000000
theorem table_eq (k l : Nat) :
    ∑a : Fin 30,Transformed01.coefficients a 0 * MomentRhoQData01.original a.val 0 k l=
      MomentRhoQData01.transformed 0 0 k l := by
  have h := IntegerTable.weighted_get_eq_of_cached_pack 144 1296 (by decide) terms
    (fun a => MomentRhoQData01.originalRow a.val 0)
    (MomentRhoQData01.transformedRow 0 0) packed0 bounds0
    (fun a => (cache0_correct a).2.2.2) checked.2.2.2
    (by intro a t ht; exact of_decide_eq_true (List.all_eq_true.mp (cache0_correct a).2.2.1 t ht))
    (by intro t ht; exact of_decide_eq_true (List.all_eq_true.mp checked.2.2.1 t ht))
    (fun a => (cache0_correct a).1) (fun a => (cache0_correct a).2.1)
    checked.2.1 checked.1 (36*k+l)
  simpa only [terms,List.map_map,Function.comp_def,←Fin.sum_univ_def,
    NumericQ01.transform_identity,MomentRhoQData01.original,MomentRhoQData01.transformed] using h
end LowOrder.T4SOS.RhoTransformPacked01.Column00_0
