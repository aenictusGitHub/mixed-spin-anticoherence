theorem raising :
    matrixDerivative inputRaising (CovariantLie04.raw 7)=ladderUpper 9*CovariantLie04.raw 7-
      CovariantLie04.raw 7*(SourceLie.Rho.raising.map (Int.castRingHom CoordinatePolynomial)) := by
  have hb : ∀r j t,t∈Covariant04.coefficients 7 r j → ∀h∈t.1,h<36 := by
