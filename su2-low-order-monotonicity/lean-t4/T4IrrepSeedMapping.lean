noncomputable def freeSeedIndex (b j : Nat) : Nat := (freeSeedIndices b).getD j 0

theorem seed_mapping : ∀ b : Fin 252,
    ∀ j : Fin (dimension b.val-constraints b.val),
    freeSeedIndex b.val j.val<687 ∧
      mon b.val (constraints b.val+j.val)=MomentSeeds.seed (freeSeedIndex b.val j.val) := by
  decide +kernel

/-- Every required block seed follows from the corresponding checked global
seed coefficient, with no large LU data imported into this bridge. -/
theorem block_seeds_of_global {R : Type*} [CommRing R] (p : MvPolynomial Nat R)
    (hseed : ∀ j : Fin 687,
      MvPolynomial.coeff (monomialExponent (MomentSeeds.seed j.val)) p=0) :
    ∀ b : Fin 252, ∀ i : Fin (dimension b.val), constraints b.val ≤ i.val →
      MvPolynomial.coeff (monomialExponent (mon b.val i.val)) p=0 := by
  intro b i hi
  let j : Fin (dimension b.val-constraints b.val) := ⟨i.val-constraints b.val,by omega⟩
  have hj : constraints b.val+j.val=i.val := by dsimp [j]; omega
  have hm := seed_mapping b j
  have hz := hseed ⟨freeSeedIndex b.val j.val,hm.1⟩
  rw [←hm.2,hj] at hz
  exact hz

