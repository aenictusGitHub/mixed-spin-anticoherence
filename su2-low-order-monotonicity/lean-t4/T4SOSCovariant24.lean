  ∑ a, ∑ b, (Data24.G a b : ℂ) * (W H * (Q H a)ᴴ * outputMetric 13 * Q H b).trace

theorem contribution_nonneg {H : Matrix (Fin 6) (Fin 6) ℂ} (hH : H.PosSemidef) :
    0 ≤ contribution H :=
  real_weighted_sos_nonneg Data24.gram_positive (outputMetric_positive 13)
    (symWeight_positive hH) (Q H)

end
end LowOrder.T4SOS.Covariant24
