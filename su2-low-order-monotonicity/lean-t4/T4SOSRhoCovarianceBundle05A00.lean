    RawQuadraticCompressed.check 96 ((i.val:Int)-(3)+1) (raisingDifference i 0)=true := by
  fin_cases i
  · exact raising_00_00
  · exact raising_01_00
  · exact raising_02_00
  · exact raising_03_00
  · exact raising_04_00
  · exact raising_05_00
  · exact raising_06_00
