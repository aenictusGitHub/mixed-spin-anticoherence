        · exact t3Facet10_box5 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
    · exact t3Facet10_box0 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
  · by_cases h1 : Z ≤ (1 / 2 : ℝ)
    · by_cases h2 : Y ≤ (3 / 4 : ℝ)
