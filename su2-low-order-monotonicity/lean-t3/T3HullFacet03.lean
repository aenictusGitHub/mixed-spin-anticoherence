/-- Every point of the unit square is covered, including box boundaries. -/
theorem t3Facet03_nonneg (Y Z : ℝ)
    (hY0 : 0 ≤ Y) (hY1 : Y ≤ 1) (hZ0 : 0 ≤ Z) (hZ1 : Z ≤ 1) :
    0 ≤ t3Facet03 Y Z := by
  by_cases h0 : Y ≤ (1 / 2 : ℝ)
  · by_cases h1 : Z ≤ (1 / 2 : ℝ)
    · exact t3Facet03_box0 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
    · exact t3Facet03_box1 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
  · by_cases h1 : Z ≤ (1 / 2 : ℝ)
    · by_cases h2 : Y ≤ (3 / 4 : ℝ)
      · by_cases h3 : Z ≤ (1 / 4 : ℝ)
        · exact t3Facet03_box3 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
        · exact t3Facet03_box4 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
      · by_cases h3 : Z ≤ (1 / 4 : ℝ)
        · exact t3Facet03_box5 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
        · exact t3Facet03_box6 Y Z (by linarith) (by linarith) (by linarith) (by linarith)
    · exact t3Facet03_box2 Y Z (by linarith) (by linarith) (by linarith) (by linarith)

end
