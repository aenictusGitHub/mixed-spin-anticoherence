FidelityOrder.scalar_order {n : ℕ} (hn : 2 ≤ n) (x : ℕ → ℝ) (hx : ∀ (i : ℕ), 0 ≤ x i) :
  ((∑ i ∈ Finset.range (n + 1), x i) ^ 2 - ∑ i ∈ Finset.range (n + 1), x i ^ 2) / ↑n ≤
    ((∑ i ∈ Finset.range n, √(FidelityOrder.mix n x i)) ^ 2 - ∑ i ∈ Finset.range (n + 1), x i ^ 2) / (↑n - 1)
FidelityOrder.matrix_order {n : ℕ} (hn : 2 ≤ n)
  (Phi : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ →ₗ[ℂ] Matrix (Fin n) (Fin n) ℂ)
  (hpos : ∀ (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ), A.PosSemidef → (Phi A).PosSemidef)
  (hTP : ∀ (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ), (Phi A).trace = A.trace) (hI : Phi 1 = ↑((↑n + 1) / ↑n) • 1)
  {A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ} (hA : A.PosSemidef) (htr : A.trace = 1) :
  ((CFC.sqrt A).trace.re ^ 2 - 1) / ↑n ≤ ((CFC.sqrt (Phi A)).trace.re ^ 2 - 1) / (↑n - 1)
FidelityOrder.symmetric_partial_trace_order (m : ℕ) (hm : 1 ≤ m) (A : Matrix (Fin (1 + m + 1)) (Fin (1 + m + 1)) ℂ)
  (hA : A.PosSemidef) (htr : A.trace = 1) :
  ((CFC.sqrt A).trace.re ^ 2 - 1) / (↑m + 1) ≤ ((CFC.sqrt (SU2T2.Dicke.marginal m 1 A)).trace.re ^ 2 - 1) / ↑m
FidelityOrder.quantum_convex_roof_order.{u_1} (m : ℕ) (hm : 1 ≤ m) {E : Type u_1} [Nonempty E] (r : E → ℕ)
  (p : (e : E) → Fin (r e) → ℝ) (B : (e : E) → Fin (r e) → Matrix (Fin (1 + m + 1)) (Fin (1 + m + 1)) ℂ)
  (hp : ∀ (e : E) (i : Fin (r e)), 0 ≤ p e i) (hB : ∀ (e : E) (i : Fin (r e)), (B e i).PosSemidef)
  (htr : ∀ (e : E) (i : Fin (r e)), (B e i).trace = 1) :
  sInf (Set.range fun e => ∑ i, p e i * (((CFC.sqrt (B e i)).trace.re ^ 2 - 1) / (↑m + 1))) ≤
    sInf (Set.range fun e => ∑ i, p e i * (((CFC.sqrt (SU2T2.Dicke.marginal m 1 (B e i))).trace.re ^ 2 - 1) / ↑m))
